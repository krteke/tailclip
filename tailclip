#!/usr/bin/env python3

import argparse
import mimetypes
import os
import re
import shutil
import subprocess
import tempfile
import time
from pathlib import Path

parser = argparse.ArgumentParser()
parser.add_argument("--files", action="store_true")
args = parser.parse_args()
CLIP_FILE = re.compile(r"^[0-9a-fA-F]{32}\.(txt|url)$")

state = (
    Path(
        os.environ.get(
            "XDG_DATA_HOME",
            Path.home() / ".local/share",
        )
    )
    / "tailclip"
)

state.mkdir(parents=True, exist_ok=True)

batch = Path(
    tempfile.mkdtemp(
        prefix="incoming.",
        dir=state,
    )
)

keep_batch = False


def notify(message: str) -> None:
    subprocess.run(
        ["notify-send", "Tailclip", message],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def wl_copy(mime: str, data=None, file=None) -> None:
    if file is not None:
        with file.open("rb") as f:
            subprocess.run(
                ["wl-copy", "--type", mime],
                stdin=f,
                check=True,
            )
    else:
        subprocess.run(
            ["wl-copy", "--type", mime],
            input=data,
            check=True,
        )


try:
    result = subprocess.run(
        [
            "tailscale",
            "file",
            "get",
            "--wait",
            "--conflict=rename",
            str(batch),
        ]
    )

    if result.returncode:
        notify("Taildrop 接收失败")
        raise SystemExit(1)

    files = [p for p in batch.iterdir()]

    if not files:
        notify("没有收到文件")
        raise SystemExit(0)

    if not args.files and len(files) == 1:
        f = files[0]
        name = f.name

        stem = f.stem

        m = CLIP_FILE.fullmatch(f.name)

        is_clip_name = len(stem) == 32 and all(
            c in "0123456789abcdefABCDEF" for c in stem
        )

        if m and m.group(1) == "txt":
            wl_copy(
                "text/plain;charset=utf-8",
                file=f,
            )

            notify("文本已复制")
            raise SystemExit(0)

        if m and m.group(1) == "url":
            url = next(
                (
                    line[4:]
                    for line in f.read_text(errors="replace").splitlines()
                    if line.startswith("URL=")
                ),
                "",
            )

            if url:
                wl_copy(
                    "text/plain;charset=utf-8",
                    data=url.encode(),
                )

                notify("URL 已复制")
                raise SystemExit(0)

        mime, _ = mimetypes.guess_type(f.name)

        if mime and mime.startswith("image/"):
            wl_copy(
                mime,
                file=f,
            )

            notify("图片已复制")
            raise SystemExit(0)

    files_root = state / "files"
    files_root.mkdir(exist_ok=True)

    final = files_root / (f"{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}")

    batch.rename(final)
    batch = final
    keep_batch = True

    files = [p for p in batch.iterdir() if p.is_file()]

    uri_list = "".join(f"{p.resolve().as_uri()}\r\n" for p in files)

    wl_copy(
        "text/uri-list",
        data=uri_list.encode(),
    )

    notify(f"已复制 {len(files)} 个文件")

finally:
    if not keep_batch:
        shutil.rmtree(batch, ignore_errors=True)
